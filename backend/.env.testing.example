# Entorno de la suite de pruebas (php artisan test). Base de datos aislada:
# phpunit.xml fuerza DB_DATABASE=restaurante_kds_test y tests/bootstrap.php la
# crea si no existe. Nunca apunta a la base de desarrollo restaurante_kds.
APP_NAME="KDS Pro"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=null
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurante_kds_test
DB_USERNAME=kds
DB_PASSWORD=change-me

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PIN_PEPPER=pepper-solo-para-pruebas-automatizadas
PIN_SESSION_IDLE_MINUTES=30
SUNAT_SEND_ENABLED=false
