# Nombre visible del producto (la marca blanca por empresa llega desde la API).
VITE_APP_NAME="KDS Pro"

# Ruta base de la API. En desarrollo Vite la redirige a DEV_API_TARGET (mismo origen).
VITE_API_BASE_URL=/api/v1
DEV_API_TARGET=http://localhost:8000

# Laravel Reverb: la clave pública debe coincidir con REVERB_APP_KEY del backend.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Modo evaluación (portafolio): muestra accesos de prueba por rol. Nunca en producción real.
VITE_DEMO_MODE=false
